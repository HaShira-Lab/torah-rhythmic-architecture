# Normalize source and documentation files across platforms.
* text=auto

*.py          text eol=lf
*.md          text eol=lf
*.cff         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
requirements.txt text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
*.bat         text eol=crlf

# Corpus and result hashes refer to exact bytes. Do not normalize them.
data/**       -text
results/**    -text
